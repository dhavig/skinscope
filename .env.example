# Copy to .env and fill in values you want to use locally.

# If you want to call the real Claude API, drop your key in here.
ANTHROPIC_API_KEY=

# Set to "true" to force mock mode even with an API key set.
# Useful for offline development and testing.
SKINSCOPE_USE_MOCK=true

# Claude model to use. Default is the most capable Opus.
SKINSCOPE_MODEL=claude-opus-4-7

# Where the SQLite db lives.
SKINSCOPE_DB_PATH=skinscope.db

# Tuning knobs.
SKINSCOPE_MAX_TOKENS=1024
SKINSCOPE_TIMEOUT_S=30
